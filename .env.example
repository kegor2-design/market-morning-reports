MMP_TIMEZONE=Asia/Seoul
MMP_PUBLIC_REPO_DIR=/home/kegor2/market-morning-reports
MMP_GITHUB_PUSH=0
MMP_BLOGGER_PUBLISH=0
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
# Codex is required for publishable market analysis. Saved Codex CLI login is reused.
MMP_CODEX_ENABLED=1
MMP_CODEX_BIN=codex
MMP_CODEX_MODEL=
MMP_CODEX_TIMEOUT_SEC=900
MMP_CODEX_MAX_EVENTS=30
# Optional for non-interactive API-key auth. Keep this file mode 600.
CODEX_API_KEY=
MMP_NEWS_MAX_AGE_HOURS=72
