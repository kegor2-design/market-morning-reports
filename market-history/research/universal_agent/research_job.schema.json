{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "goal", "mode", "max_seconds", "max_restarts", "max_model_calls"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "goal": {"type": "string", "minLength": 10, "maxLength": 1000},
    "mode": {"enum": ["synthetic_research", "pit_problem", "guided_experiment", "guided_e2e", "evidence_workflow", "data_recovery"]},
    "data_request": {"type": "object", "additionalProperties": false,
      "required": ["goal_id", "job_id", "task_id", "series", "market", "start", "end", "expected_dates", "existing", "unit", "allowed_sources", "budget"],
      "properties": {
        "goal_id": {"type": "string", "minLength": 3}, "job_id": {"type": "string", "minLength": 3},
        "task_id": {"type": "string", "minLength": 3},
        "series": {"enum": ["UST_2Y", "UST_10Y", "NYFED_SOFR"]}, "market": {"const": "US"},
        "start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"},
        "expected_dates": {"type": "array", "minItems": 1, "maxItems": 366,
          "uniqueItems": true, "items": {"type": "string", "format": "date"}},
        "existing": {"type": "object", "maxProperties": 366,
          "additionalProperties": {"type": "string"}},
        "unit": {"const": "percent"},
        "allowed_sources": {"type": "array", "minItems": 1, "maxItems": 4,
          "uniqueItems": true, "items": {"enum": ["US_TREASURY", "NYFED_REFERENCE_RATES", "FED_H15", "FRED_ALFRED"]}},
        "existing_source": {"enum": ["FRED_INITIAL_HASHED"]},
        "cross_validate": {"type": "boolean"},
        "budget": {"type": "object", "additionalProperties": false,
          "required": ["max_seconds", "max_network_requests", "max_retries", "max_model_calls"],
          "properties": {"max_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
            "max_network_requests": {"type": "integer", "minimum": 0, "maximum": 3},
            "max_retries": {"type": "integer", "minimum": 0, "maximum": 2},
            "max_model_calls": {"const": 0}}}}},
    "evidence_request": {"type": "object", "additionalProperties": false,
      "required": ["goal_id", "task_id", "indicator", "source", "data_requirement", "as_of", "allowed_sources", "budget", "policy"],
      "properties": {
        "goal_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "indicator": {"type": "string", "minLength": 1, "maxLength": 32},
        "source": {"type": "string", "minLength": 1, "maxLength": 64},
        "data_requirement": {"type": "string", "minLength": 1, "maxLength": 200},
        "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+]09:00$"},
        "allowed_sources": {"type": "array", "minItems": 1, "maxItems": 4,
          "uniqueItems": true, "items": {"enum": ["FRED_ALFRED", "FED_H15", "US_TREASURY", "READ_ONLY_DB"]}},
        "budget": {"type": "object", "additionalProperties": false,
          "required": ["max_seconds", "max_network_requests", "max_model_calls"],
          "properties": {"max_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
            "max_network_requests": {"const": 0}, "max_model_calls": {"const": 0}}},
        "policy": {"type": "object", "additionalProperties": false,
          "required": ["read_only", "official_claim_allowed"],
          "properties": {"read_only": {"const": true}, "official_claim_allowed": {"const": false}}}
      }},
    "next_task": {"type": "object", "additionalProperties": false,
      "required": ["task_id", "mode", "independent_of", "priority", "synthetic_values"],
      "properties": {"task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "mode": {"const": "synthetic_research"}, "independent_of": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "synthetic_values": {"type": "array", "minItems": 3, "maxItems": 32,
          "items": {"type": "number", "minimum": -100, "maximum": 100}}}},
    "fixture_delay_after_evidence_seconds": {"type": "number", "minimum": 0, "maximum": 3},
    "ai_state_dir": {"type": "string", "minLength": 1},
    "guided_state_dir": {"type": "string", "minLength": 1},
    "fault_kind": {"enum": ["library_call"]},
    "max_follow_on_hypotheses": {"type": "integer", "minimum": 1, "maximum": 2},
    "hypothesis": {"type": "object", "additionalProperties": false,
      "required": ["direction", "threshold"], "properties": {
        "direction": {"enum": ["mean_above", "mean_below"]},
        "threshold": {"type": "number", "minimum": -100, "maximum": 100}}},
    "synthetic_values": {"type": "array", "minItems": 3, "maxItems": 32,
      "items": {"type": "number", "minimum": -100, "maximum": 100}},
    "max_seconds": {"type": "integer", "minimum": 10, "maximum": 600},
    "max_restarts": {"type": "integer", "minimum": 0, "maximum": 2},
    "max_model_calls": {"type": "integer", "minimum": 0, "maximum": 10},
    "fixture_delay_after_output_seconds": {"type": "number", "minimum": 0, "maximum": 3},
    "fixture_delay_before_output_seconds": {"type": "number", "minimum": 0, "maximum": 3}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "synthetic_research"}}},
     "then": {"required": ["hypothesis", "synthetic_values"],
              "properties": {"max_model_calls": {"const": 0}}}},
    {"if": {"properties": {"mode": {"const": "pit_problem"}}},
     "then": {"properties": {"max_model_calls": {"const": 1}},
              "not": {"anyOf": [{"required": ["synthetic_values"]},
                                 {"required": ["hypothesis"]}, {"required": ["ai_state_dir"]},
                                 {"required": ["guided_state_dir"]}]}}},
    {"if": {"properties": {"mode": {"const": "guided_experiment"}}},
     "then": {"required": ["ai_state_dir", "guided_state_dir"],
              "properties": {"max_model_calls": {"minimum": 2, "maximum": 4}},
              "not": {"anyOf": [{"required": ["synthetic_values"]},
                                 {"required": ["hypothesis"]}]}}},
    {"if": {"properties": {"mode": {"const": "evidence_workflow"}}},
     "then": {"required": ["evidence_request", "next_task"],
              "properties": {"max_model_calls": {"const": 0},
                             "max_seconds": {"maximum": 120}},
              "not": {"anyOf": [{"required": ["hypothesis"]},
                                 {"required": ["synthetic_values"]},
                                 {"required": ["ai_state_dir"]},
                                 {"required": ["guided_state_dir"]}]}}},
    {"if": {"properties": {"mode": {"const": "data_recovery"}}},
     "then": {"required": ["data_request"],
              "properties": {"max_model_calls": {"const": 0}, "max_seconds": {"maximum": 120}},
              "not": {"anyOf": [{"required": ["hypothesis"]},
                                 {"required": ["synthetic_values"]},
                                 {"required": ["ai_state_dir"]},
                                 {"required": ["guided_state_dir"]}]}}},
    {"if": {"properties": {"mode": {"const": "guided_e2e"}}},
     "then": {"required": ["ai_state_dir", "guided_state_dir", "fault_kind", "max_follow_on_hypotheses"],
              "properties": {"max_model_calls": {"minimum": 3, "maximum": 10}},
              "not": {"anyOf": [{"required": ["synthetic_values"]},
                                 {"required": ["hypothesis"]}]}}}
  ]
}
