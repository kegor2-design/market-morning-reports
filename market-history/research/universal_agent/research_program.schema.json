{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "goal_id", "research_goal", "market", "research_period", "data_requirements", "research_hypotheses", "evaluation_methods", "pit_requirements", "holdout_requirements", "allowed_sources", "resource_budget", "completion_criteria", "safety_policy", "default_reasons", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "goal_id": {"type": "string", "pattern": "^research_[0-9a-f]{12}$"},
    "research_goal": {"type": "string", "minLength": 10, "maxLength": 1000},
    "market": {"enum": ["US_RATES", "KR_EQUITY_CONTEXT"]},
    "research_period": {"type": "object", "required": ["start", "end", "resolution"], "additionalProperties": false,
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "resolution": {"const": "daily"}}},
    "data_requirements": {"type": "array", "minItems": 3, "items": {"enum": ["UST_2Y", "UST_10Y", "NYFED_SOFR"]}},
    "research_hypotheses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evaluation_methods": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pit_requirements": {"type": "string"},
    "holdout_requirements": {"type": "string"},
    "allowed_sources": {"type": "array", "uniqueItems": true,
      "items": {"enum": ["US_TREASURY", "NYFED_REFERENCE_RATES", "FRED_ALFRED"]}},
    "resource_budget": {"type": "object", "required": ["max_seconds", "max_network_requests", "max_model_calls", "max_tasks"], "additionalProperties": false,
      "properties": {"max_seconds": {"type": "integer", "minimum": 10, "maximum": 300},
        "max_network_requests": {"type": "integer", "minimum": 0, "maximum": 3},
        "max_model_calls": {"const": 0}, "max_tasks": {"type": "integer", "minimum": 1, "maximum": 12}}},
    "completion_criteria": {"type": "string"},
    "safety_policy": {"type": "object", "required": ["read_only", "official_claim_allowed", "production_changes"], "additionalProperties": false,
      "properties": {"read_only": {"const": true}, "official_claim_allowed": {"const": false}, "production_changes": {"const": false}}},
    "default_reasons": {"type": "array", "items": {"type": "string"}},
    "tasks": {"type": "array", "minItems": 4, "maxItems": 12,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["task_id", "task_type", "dependencies", "inputs", "outputs", "priority", "estimated_cost", "resource_budget", "allowed_actions", "retry_policy", "verification_rule", "status", "checkpoint", "next_action"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "task_type": {"enum": ["DATA_DISCOVERY", "DATA_ACQUISITION", "PIT_VALIDATION", "EXPERIMENT_EXECUTION"]},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "inputs": {"type": "object"}, "outputs": {"type": "array", "items": {"type": "string"}},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100},
          "estimated_cost": {"type": "number", "minimum": 0},
          "resource_budget": {"type": "object"},
          "allowed_actions": {"type": "array", "items": {"enum": ["CHECK_EXISTING_DATA", "DATA_RECOVERY", "EVIDENCE_WORKFLOW", "RATE_ANALYSIS"]}},
          "retry_policy": {"type": "object"}, "verification_rule": {"type": "string"},
          "status": {"enum": ["PENDING", "READY", "RUNNING", "WAITING_DEPENDENCY", "BLOCKED_EVIDENCE", "BLOCKED_ENV", "APPROVAL_REQUIRED", "FAILED", "COMPLETED_EXPLORATORY", "VERIFIED", "CANCELLED"]},
          "checkpoint": {"type": ["string", "null"]}, "next_action": {"type": ["string", "null"]}
        }}
  }}
}
