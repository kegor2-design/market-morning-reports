{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "reason", "failure_cause", "required_tasks", "automatic", "estimated_cost", "retry_count", "stop_condition"],
  "properties": {
    "action": {"type": "string", "enum": ["PIT_VALIDATION_REQUIRED", "DATA_ACQUISITION_REQUIRED", "NEW_HYPOTHESIS_REQUIRED", "INDEPENDENT_VALIDATION_REQUIRED", "CODE_REPAIR_REQUIRED", "RESEARCH_COMPLETED"]},
    "reason": {"type": "string", "minLength": 10},
    "failure_cause": {"type": "string", "minLength": 5},
    "required_tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "automatic": {"type": "boolean"},
    "estimated_cost": {"type": "string", "minLength": 5},
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "stop_condition": {"type": "string", "minLength": 10}
  }
}
