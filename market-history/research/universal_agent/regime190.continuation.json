          "equals": 2499
        },
        {
          "kind": "json_equals",
          "path": "market-morning-reports/market-history/research/regime190/source_lineage_20261031.json",
          "pointer": "/export_symbols",
          "equals": 2497
        },
        {
          "kind": "json_equals",
          "path": "market-morning-reports/market-history/research/regime190/source_lineage_20261031.json",
          "pointer": "/cutoff_source_same_symbols",
          "equals": 1791
        },
        {
          "kind": "json_equals",
          "path": "market-morning-reports/market-history/research/regime190/source_lineage_20261031.json",
          "pointer": "/cutoff_source_later_symbols",
