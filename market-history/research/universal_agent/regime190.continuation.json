      "verification_method": "Independent read-only file/SQLite evidence checks",
      "checks": [
        {
          "kind": "json_equals",
          "path": "market-morning-reports/market-history/research/regime190/universe_evidence_20261031.json",
          "pointer": "/source_symbol_count",
          "equals": 2499
        },
        {
          "kind": "json_equals",
          "path": "market-morning-reports/market-history/research/regime190/universe_evidence_20261031.json",
