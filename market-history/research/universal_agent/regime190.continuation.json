    "Which price cutoffs exist in source versus export?",
    "Can historical KOSPI/KOSDAQ membership be established as-of date?",
    "Which of 190 indicators have traceable PIT evidence?"
  ],
  "success_criteria": [
    "Full cutoff cause independently verified",
    "Historical market membership verified as of date",
    "Required indicators pass PIT eligibility"
  ],
  "success_checks": [
    {
      "kind": "review_required",
      "reason": "Ingestion/provider root cause not yet independently proven"
    },
    {
      "kind": "review_required",
      "reason": "Historical as-of market membership not yet reconstructed"
    },
    {
      "kind": "review_required",
      "reason": "No indicator has row-level PIT certification"
    }
  ],
  "data_sources": [
    "Read-only public.domestic_daily_price and historical_backfill_run",
    "Private export manifest and published audit tables",
    "Current symbol_master and KRX official candidate sources"
  ],
  "allowed_operations": [
    "Read-only SQL",
    "Read-only file inspection",
    "Research checkpoint and evidence output"
  ],
  "constraints": [
    "No production DB writes",
    "No broad backfill",
    "No current-membership substitution",
    "No PIT-dependent backtest"
  ],
  "codex_execution_enabled": false,
  "data_access": [
    "market-morning-reports/market-history/research/regime190/source_lineage_20261031.json",
    "market-morning-reports/market-history/research/regime190/source_lineage_symbols_20261031.csv",
    "market-morning-reports/market-history/research/regime190/universe_evidence_20261031.json",
    "market-morning-reports/market-history/research/regime190/pit_readiness_summary_20261031.json",
    "market-morning-reports/market-history/research/regime190/pit_readiness_matrix_20261031.csv",
    "MyDream2000/research/regime190/checkpoint.sqlite"
  ],
  "limits": {
    "max_runtime_seconds": 1800,
    "max_iterations": 3,
    "max_retries": 3,
    "max_concurrency": 1,
    "max_processes": 1,
    "min_free_bytes": 5368709120,
    "max_state_bytes": 10485760,
    "max_log_bytes": 131072,
    "max_external_calls": 1
  },
