{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "original_research_goal", "market", "hypothesis", "data_requirements", "allowed_sources", "evaluation_methods", "task_dag", "pit_status", "holdout_status"],
  "properties": {
    "goal_id": {"type": "string", "pattern": "^research_[0-9a-f]{12}$"},
    "original_research_goal": {"type": "string", "minLength": 10, "maxLength": 1000},
    "market": {"enum": ["US_RATES", "KR_EQUITY_CONTEXT", "KR_EQUITY_EXPLORATORY"]},
    "hypothesis": {"type": "string", "minLength": 20, "maxLength": 1000},
    "data_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "allowed_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "evaluation_methods": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "task_dag": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_type", "dependencies", "allowed_actions"],
      "properties": {
        "task_id": {"type": "string"}, "task_type": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "allowed_actions": {"type": "array", "items": {"type": "string"}}
      }
    }},
    "pit_status": {"const": "UNVERIFIED"},
    "holdout_status": {"const": "NOT_AVAILABLE"}
  }
}
