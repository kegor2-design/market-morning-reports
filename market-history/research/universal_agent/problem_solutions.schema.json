{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["problem_type", "root_cause", "evidence_assessment", "solutions"],
  "properties": {
    "problem_type": {"type": "string", "minLength": 4, "maxLength": 80},
    "root_cause": {"type": "string", "minLength": 10, "maxLength": 1000},
    "evidence_assessment": {"type": "string", "minLength": 10, "maxLength": 1000},
    "solutions": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action", "reason", "resolution_likelihood", "evidence_reliability", "cost", "time", "security_risk", "regression_risk", "rollback_ease"],
        "properties": {
          "action": {"type": "string", "enum": ["VERIFY_PIT_LOCAL", "RUN_EXISTING_EXPLORATORY", "COLLECT_EXTERNAL_PIT_DATA", "CHANGE_DB_SCHEMA", "DISABLE_SANDBOX", "STOP_AND_REPORT"]},
          "reason": {"type": "string", "minLength": 8, "maxLength": 500},
          "resolution_likelihood": {"type": "integer", "minimum": 0, "maximum": 5},
          "evidence_reliability": {"type": "integer", "minimum": 0, "maximum": 5},
          "cost": {"type": "integer", "minimum": 0, "maximum": 5},
          "time": {"type": "integer", "minimum": 0, "maximum": 5},
          "security_risk": {"type": "integer", "minimum": 0, "maximum": 5},
          "regression_risk": {"type": "integer", "minimum": 0, "maximum": 5},
          "rollback_ease": {"type": "integer", "minimum": 0, "maximum": 5}
        }
      }
    }
  }
}
