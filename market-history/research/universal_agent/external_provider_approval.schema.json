{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "scope", "goal_id", "original_task_id", "provider",
    "host", "endpoint", "series", "period", "original_request_sha256",
    "new_request_id", "error_evidence_sha256", "approved_by", "approved_at_utc",
    "expires_at_utc", "max_additional_requests", "max_duration_seconds",
    "max_cost_usd", "retry_policy", "idempotency_policy", "response_media_type",
    "verification_rule", "terms_reviewed", "access_reviewed", "tls_verification",
    "redirect_policy", "max_response_bytes"],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"const": "EXTERNAL_PROVIDER_RECOVERY_APPROVAL"},
    "goal_id": {"type": "string", "pattern": "^research_[0-9a-f]{12}$"},
    "original_task_id": {"type": "string", "pattern": "^collect_[a-z0-9_]+$"},
    "provider": {"enum": ["US_TREASURY", "NYFED_REFERENCE_RATES"]},
    "host": {"type": "string", "minLength": 4},
    "endpoint": {"type": "string", "pattern": "^https://"},
    "series": {"enum": ["UST_2Y", "UST_10Y", "NYFED_SOFR"]},
    "period": {"type": "object", "additionalProperties": false,
      "required": ["start", "end", "resolution"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"},
        "resolution": {"const": "daily"}}},
    "original_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "new_request_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "error_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_by": {"type": "string", "minLength": 3},
    "approved_at_utc": {"type": "string", "minLength": 20},
    "expires_at_utc": {"type": "string", "minLength": 20},
    "max_additional_requests": {"const": 1},
    "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 25},
    "max_cost_usd": {"const": 0},
    "retry_policy": {"const": "ONE_NEW_IDEMPOTENT_GET"},
    "idempotency_policy": {"const": "SAFE_GET_ONLY"},
    "response_media_type": {"enum": ["text/csv", "application/json"]},
    "verification_rule": {"const": "independent_source_recompute"},
    "terms_reviewed": {"const": true}, "access_reviewed": {"const": true},
    "tls_verification": {"const": true}, "redirect_policy": {"const": "DENY_ALL"},
    "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 2000000}
  }
}
