{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis_id", "hypothesis", "supporting_evidence", "expected_effect", "required_data", "experiment_design", "validation_method", "failure_criteria", "estimated_cost", "code"],
  "properties": {
    "hypothesis_id": {"type": "string", "pattern": "^H-[A-Z0-9_-]+$"},
    "hypothesis": {"type": "string", "minLength": 20},
    "supporting_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_effect": {"type": "string", "minLength": 5},
    "required_data": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "experiment_design": {"type": "string", "minLength": 10},
    "validation_method": {"type": "string", "minLength": 10},
    "failure_criteria": {"type": "string", "minLength": 10},
    "estimated_cost": {"type": "string", "minLength": 5},
    "code": {"type": "string", "minLength": 100, "maxLength": 20000}
  }
}
