{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regime190 Agent 4.2 Codex research task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "research_objective", "problem_id", "evidence", "hypothesis", "required_inputs", "allowed_paths", "forbidden_paths", "allowed_operations", "validation_method", "success_criteria", "failure_criteria", "rollback_method", "expected_outputs", "generation_method"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "research_objective": {"type": "string", "minLength": 10},
    "problem_id": {"type": "string", "minLength": 3},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "hypothesis": {"type": "string", "minLength": 10},
    "required_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_operations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation_method": {"type": "string", "minLength": 10},
    "success_criteria": {"type": "string", "minLength": 10},
    "failure_criteria": {"type": "string", "minLength": 10},
    "rollback_method": {"type": "string", "minLength": 10},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "generation_method": {"enum": ["DETERMINISTIC_RULE_TEMPLATE", "CODEX_GENERATED"]},
    "updated_at_utc": {"type": "string", "format": "date-time"}
  }
}
