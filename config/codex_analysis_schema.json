{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "insight_version", "report_date", "as_of_kst",
    "data_quality_summary", "one_line_diagnosis", "overall_confidence",
    "regime", "key_drivers", "regional_reviews", "macro_policy_reviews", "korea_after_close_news", "news_industry_impacts",
    "industry_company_reviews", "preopen_stock_candidates", "investment_committee", "korea_market",
    "scenarios", "watch_items", "missing_data", "invalidation_conditions",
    "applied_principles", "candidate_views", "event_summaries_ko", "mi_predictions"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.3"},
    "insight_version": {"type": "string", "minLength": 1},
    "report_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "as_of_kst": {"type": "string", "minLength": 1},
    "data_quality_summary": {"type": "string", "minLength": 1},
    "one_line_diagnosis": {"type": "string", "minLength": 1},
    "overall_confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "regime": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "change_from_prior", "rationale", "components"],
      "properties": {
        "state": {"enum": ["RISK_ON_TREND", "RISK_ON_SELECTIVE", "CHOPPY", "RISK_OFF_WEAK", "RISK_OFF_PANIC", "RECOVERY_EARLY", "UNKNOWN"]},
        "change_from_prior": {"type": "string"},
        "rationale": {"type": "string", "minLength": 1},
        "components": {"type": "array", "items": {"$ref": "#/$defs/component"}, "minItems": 1}
      }
    },
    "key_drivers": {"type": "array", "items": {"$ref": "#/$defs/review"}, "maxItems": 5},
    "regional_reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}, "maxItems": 8},
    "macro_policy_reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}, "maxItems": 5},
    "korea_after_close_news": {"type": "array", "items": {"$ref": "#/$defs/afterCloseNews"}, "maxItems": 8},
    "news_industry_impacts": {"type": "array", "items": {"$ref": "#/$defs/newsIndustryImpact"}, "maxItems": 8},
    "industry_company_reviews": {"type": "array", "items": {"$ref": "#/$defs/deepReview"}, "maxItems": 5},
    "preopen_stock_candidates": {"type": "array", "items": {"$ref": "#/$defs/preopenStockCandidate"}, "maxItems": 5},
    "investment_committee": {"type": "array", "items": {"$ref": "#/$defs/debate"}, "maxItems": 3},
    "korea_market": {
      "type": "object", "additionalProperties": false,
      "required": ["kospi", "kosdaq", "transmission_summary", "sectors"],
      "properties": {
        "kospi": {"type": "string", "minLength": 1},
        "kosdaq": {"type": "string", "minLength": 1},
        "transmission_summary": {"type": "string", "minLength": 1},
        "sectors": {"type": "array", "items": {"$ref": "#/$defs/sector"}, "maxItems": 12}
      }
    },
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}, "minItems": 3, "maxItems": 3},
    "watch_items": {"type": "array", "items": {"type": "string"}, "maxItems": 15},
    "missing_data": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 20},
    "invalidation_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 15},
    "applied_principles": {"type": "array", "items": {"$ref": "#/$defs/principle"}, "minItems": 1, "maxItems": 9},
    "candidate_views": {"type": "array", "items": {"type": "string"}, "maxItems": 10}
    ,"event_summaries_ko": {"type": "array", "items": {"$ref": "#/$defs/eventSummary"}, "maxItems": 24},
    "mi_predictions": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mi_id", "target_asset", "target_metric", "horizon", "direction", "confidence", "baseline_value", "flat_band_pct", "expected_range_low", "expected_range_high", "regime", "summary", "invalidation_conditions", "event_ids", "primitive_keys", "expert_claim_ids", "source_registry_ids"],
        "properties": {
          "mi_id": {"type": "string", "minLength": 1}, "target_asset": {"type": "string", "minLength": 1},
          "target_metric": {"type": "string", "minLength": 1},
          "horizon": {"enum": ["INTRADAY", "1D", "3D", "1W", "2W", "1M", "3M", "6M", "1Y"]},
          "direction": {"enum": ["UP", "DOWN", "FLAT"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "baseline_value": {"type": "number"}, "flat_band_pct": {"type": ["number", "null"], "minimum": 0},
          "expected_range_low": {"type": ["number", "null"]}, "expected_range_high": {"type": ["number", "null"]},
          "regime": {"type": ["string", "null"]}, "summary": {"type": "string", "minLength": 1},
          "invalidation_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "event_ids": {"type": "array", "items": {"type": "string"}}, "primitive_keys": {"type": "array", "items": {"type": "string"}},
          "expert_claim_ids": {"type": "array", "items": {"type": "string"}}, "source_registry_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "eventSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "summary_ko"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^EVT-[0-9]{3}$"},
        "summary_ko": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "state", "reason"],
      "properties": {
        "name": {"enum": ["LIQUIDITY", "EARNINGS", "INDUSTRY_CYCLE", "POSITIONING", "MARKET_INTERNALS", "PRICE_CONFIRMATION"]},
        "state": {"enum": ["IMPROVING", "NEUTRAL", "MIXED", "DETERIORATING", "UNKNOWN"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "facts", "interpretation", "counterevidence", "korea_transmission", "source_event_ids"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "facts": {"type": "string", "minLength": 1},
        "interpretation": {"type": "string", "minLength": 1},
        "counterevidence": {"type": "string", "minLength": 1},
        "korea_transmission": {"type": "string", "minLength": 1},
        "source_event_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "deepReview": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "facts", "earnings_cycle", "positive_view", "negative_view", "current_judgment", "korea_value_chain", "confirmation", "invalidation", "source_event_ids"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "facts": {"type": "string", "minLength": 1},
        "earnings_cycle": {"type": "string", "minLength": 1},
        "positive_view": {"type": "string", "minLength": 1},
        "negative_view": {"type": "string", "minLength": 1},
        "current_judgment": {"type": "string", "minLength": 1},
        "korea_value_chain": {"type": "string", "minLength": 1},
        "confirmation": {"type": "string", "minLength": 1},
        "invalidation": {"type": "string", "minLength": 1},
        "source_event_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "newsIndustryImpact": {
      "type": "object", "additionalProperties": false,
      "required": ["news_issue", "positive_industries", "negative_industries", "transmission_path", "horizon", "confidence", "confirmation", "invalidation", "source_event_ids"],
      "properties": {
        "news_issue": {"type": "string", "minLength": 1},
        "positive_industries": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 5},
        "negative_industries": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 5},
        "transmission_path": {"type": "string", "minLength": 1},
        "horizon": {"enum": ["NEXT_SESSION", "SWING_1_4W", "MEDIUM_1_6M", "MULTI_HORIZON"]},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "confirmation": {"type": "string", "minLength": 1},
        "invalidation": {"type": "string", "minLength": 1},
        "source_event_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "afterCloseNews": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "announced_at_kst", "facts", "verification_level", "positive_industries", "negative_industries", "next_session_impact", "confidence", "confirmation", "source_event_ids"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "announced_at_kst": {"type": "string", "minLength": 1},
        "facts": {"type": "string", "minLength": 1},
        "verification_level": {"enum": ["OFFICIAL", "CROSS_CHECKED", "SINGLE_REPORT"]},
        "positive_industries": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 5},
        "negative_industries": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 5},
        "next_session_impact": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "confirmation": {"type": "string", "minLength": 1},
        "source_event_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "preopenStockCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "name", "market", "status", "linked_industries", "selection_reason", "evidence_strength", "fundamental_score", "ap_preopen_check", "confirmation", "invalidation", "source_event_ids"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[0-9A-Z]{6}$"},
        "name": {"type": "string", "minLength": 1},
        "market": {"type": "string", "minLength": 1},
        "status": {"enum": ["CORE_WATCH", "CONDITIONAL_WATCH"]},
        "linked_industries": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 5},
        "selection_reason": {"type": "string", "minLength": 1},
        "evidence_strength": {"enum": ["DIRECT_DISCLOSURE", "VERIFIED_EXPOSURE", "DIRECT_MENTION_ONLY"]},
        "fundamental_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "ap_preopen_check": {"type": "string", "minLength": 1},
        "confirmation": {"type": "string", "minLength": 1},
        "invalidation": {"type": "string", "minLength": 1},
        "source_event_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "debate": {
      "type": "object", "additionalProperties": false,
      "required": ["issue", "positive_view", "negative_or_alternative_view", "current_judgment", "required_confirmation", "principle_ids"],
      "properties": {
        "issue": {"type": "string", "minLength": 1},
        "positive_view": {"type": "string", "minLength": 1},
        "negative_or_alternative_view": {"type": "string", "minLength": 1},
        "current_judgment": {"type": "string", "minLength": 1},
        "required_confirmation": {"type": "string", "minLength": 1},
        "principle_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sector": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "stance", "horizon", "reason", "invalidation"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "stance": {"enum": ["PRIORITIZE", "WATCH", "AVOID", "UNKNOWN"]},
        "horizon": {"enum": ["NEXT_SESSION", "SWING_1_4W", "MEDIUM_1_6M", "MULTI_HORIZON"]},
        "reason": {"type": "string", "minLength": 1},
        "invalidation": {"type": "string", "minLength": 1}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["horizon", "base", "bull", "bear", "switch_conditions"],
      "properties": {
        "horizon": {"enum": ["NEXT_SESSION", "SWING_1_4W", "MEDIUM_1_6M"]},
        "base": {"type": "string", "minLength": 1},
        "bull": {"type": "string", "minLength": 1},
        "bear": {"type": "string", "minLength": 1},
        "switch_conditions": {"type": "string", "minLength": 1}
      }
    },
    "principle": {
      "type": "object", "additionalProperties": false,
      "required": ["principle_id", "version", "effect", "reason"],
      "properties": {
        "principle_id": {"enum": ["MI-001", "MI-002", "MI-003", "MI-004", "MI-005", "MI-006", "MI-007", "MI-008", "MI-009"]},
        "version": {"type": "integer", "const": 1},
        "effect": {"enum": ["SUPPORTS", "CONTRADICTS", "LIMITS", "REQUIRES_CONFIRMATION"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
