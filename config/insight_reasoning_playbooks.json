{
  "schema_version": "1.0",
  "standard_reasoning_steps": [
    {
      "step": 1,
      "id": "EVENT_FACT",
      "question": "무슨 일이 발생했는가? 확인된 사실과 주장/해석을 분리한다."
    },
    {
      "step": 2,
      "id": "SURPRISE",
      "question": "사전 기대와 무엇이 달랐는가?"
    },
    {
      "step": 3,
      "id": "WHY_NOW",
      "question": "왜 지금 발생했는가? 직전 상태 변화와 병목을 찾는다."
    },
    {
      "step": 4,
      "id": "CONSTRAINT",
      "question": "정치·제도·재정·기업의 제약조건과 마감시간은 무엇인가?"
    },
    {
      "step": 5,
      "id": "MONEY_SOURCE",
      "question": "돈은 어디서 오는가? 세금·부채·현금·신용·통화 중 무엇인가?"
    },
    {
      "step": 6,
      "id": "MARGINAL_BUYER",
      "question": "추가 물량의 marginal buyer는 누구이며 capacity가 남아 있는가?"
    },
    {
      "step": 7,
      "id": "BALANCE_SHEET",
      "question": "어느 주체의 자산·부채·담보·레버리지가 어떻게 변하는가?"
    },
    {
      "step": 8,
      "id": "FUNDAMENTALS",
      "question": "매출·이익·EPS·현금흐름이 실제로 바뀌는가?"
    },
    {
      "step": 9,
      "id": "INDUSTRY_CYCLE",
      "question": "재고·출하·ASP·가동률·수주·CAPEX는 어느 사이클인가?"
    },
    {
      "step": 10,
      "id": "VALUATION",
      "question": "현재 가격은 미래 이익 변화와 비교해 얼마나 반영했는가?"
    },
    {
      "step": 11,
      "id": "POSITIONING",
      "question": "누가 사고팔고 있으며 헤지·레버리지·강제청산이 있는가?"
    },
    {
      "step": 12,
      "id": "BREADTH",
      "question": "지수 움직임을 시장 전체가 동의하는가?"
    },
    {
      "step": 13,
      "id": "CHART_CONFIRMATION",
      "question": "차트와 가격행동이 가설을 확인하는가? 차트는 단독 결론이 아니라 증거다."
    },
    {
      "step": 14,
      "id": "HISTORY",
      "question": "당시 알 수 있었던 정보 기준으로 가장 유사한 역사 사례는 무엇이며 차이는 무엇인가?"
    },
    {
      "step": 15,
      "id": "ALTERNATIVES",
      "question": "서로 독립적인 대안 가설을 최소 2개 만든다."
    },
    {
      "step": 16,
      "id": "SCENARIOS",
      "question": "BASE/BULL/BEAR 시나리오와 전환조건을 정의한다."
    },
    {
      "step": 17,
      "id": "INVALIDATION",
      "question": "어떤 데이터가 나오면 현재 가설을 폐기하거나 수정해야 하는가?"
    },
    {
      "step": 18,
      "id": "REACTION",
      "question": "T+30M/D+1/D+5/D+20 시장반응과 지속성을 확인한다."
    },
    {
      "step": 19,
      "id": "KR_TRANSMISSION",
      "question": "환율·외국인 현선물·산업·기업이익을 통해 한국에 어떻게 전달되는가?"
    },
    {
      "step": 20,
      "id": "LEARN",
      "question": "결과를 Hypothesis Ledger·Historical Case·Metric Registry·Playbook에 다시 반영한다."
    }
  ],
