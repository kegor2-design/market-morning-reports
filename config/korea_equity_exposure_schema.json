{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contract", "rows"],
  "properties": {
    "contract": {"const": "MMP_KR_EQUITY_EXPOSURE_V1"},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/exposure"}}
  },
  "$defs": {
    "exposure": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "industry", "value_chain_role", "exposure_relation", "candidate_eligible", "match_keywords", "revenue_exposure_pct", "evidence_type", "evidence_url", "evidence_date", "confidence", "evidence_status"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[0-9A-Z]{6}$"},
        "industry": {"type": "string", "minLength": 1},
        "value_chain_role": {"type": "string", "minLength": 1},
        "exposure_relation": {"enum": ["PRODUCER_SERVICE", "INPUT_DEPENDENCY", "CUSTOMER_MARKET", "AFFILIATE", "INCIDENTAL_MENTION", "UNKNOWN"]},
        "candidate_eligible": {"type": "boolean"},
        "match_keywords": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "revenue_exposure_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "evidence_type": {"enum": ["DART_BUSINESS_REPORT", "DART_MATERIAL_EVENT", "COMPANY_IR", "OFFICIAL_OTHER"]},
        "evidence_url": {"type": "string", "minLength": 1},
        "evidence_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "evidence_status": {"enum": ["REVIEW_REQUIRED", "VERIFIED", "STALE", "REJECTED"]}
      }
    }
  }
}
